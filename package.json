{
  "name": "atlas-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "config:check": "expo config --type public && expo install --check && expo-doctor",
    "check:android": "expo export --platform android --output-dir dist/android",
    "check:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@supabase/supabase-js": "2.115.0",
    "expo": "57.0.20",
    "expo-constants": "57.0.17",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-secure-store": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0",
    "expo-system-ui": "57.0.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
